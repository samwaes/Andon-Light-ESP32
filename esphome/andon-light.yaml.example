substitutions:
  device_name: andon-light-01
  friendly_name: "Andon Light 01"

esphome:
  name: ${device_name}
  friendly_name: ${friendly_name}
  project:
    name: hupla.andon-light
    version: "0.5.0"

  on_boot:
    priority: -10
    then:
      - delay: 500ms
      - script.execute: render_andon

      # Load the MQTT settings restored by the template entities and
      # connect without requiring a firmware rebuild.
      - delay: 1s
      - if:
          condition:
            lambda: |-
              return !id(mqtt_broker_config).state.empty();
          then:
            - lambda: |-
                id(mqtt_client).set_broker_address(id(mqtt_broker_config).state);
                id(mqtt_client).set_broker_port(
                  static_cast<uint16_t>(id(mqtt_port_config).state)
                );
                id(mqtt_client).set_username(id(mqtt_username_config).state);
                id(mqtt_client).set_password(id(mqtt_password_config).state);
            - mqtt.enable:
          else:
            - logger.log:
                level: WARN
                format: "MQTT broker is empty; MQTT remains disabled"

esp32:
  board: esp32dev
  framework:
    type: esp-idf

logger:
  level: DEBUG

api:
  encryption:
    key: !secret api_encryption_key
  reboot_timeout: 0s

# MQTT starts disabled so the broker can be changed at runtime from
# the local web interface. The settings below are applied on boot and
# whenever "Save & Connect MQTT" is pressed.
mqtt:
  id: mqtt_client
  broker: ""
  port: 1883
  enable_on_boot: false
  discovery: false
  reboot_timeout: 0s

  on_connect:
    - logger.log: "MQTT broker connected"

  on_disconnect:
    - logger.log: "MQTT broker disconnected"

ota:
  - platform: esphome
    password: !secret ota_password
  - platform: web_server

wifi:
  networks:
    - ssid: !secret wifi_home_ssid
      password: !secret wifi_home_password

  ap:
    ssid: "Andon-Setup"
    password: !secret fallback_ap_password
    ap_timeout: 20s

  reboot_timeout: 0s
  power_save_mode: none

# No captive_portal:
# the normal web UI must remain usable while connected to Andon-Setup.

web_server:
  port: 80
  version: 3
  local: true

  auth:
    username: !secret web_username
    password: !secret web_password
    type: basic

  sorting_groups:
    - id: group_mode
      name: "Andon Mode & Alarm"
      sorting_weight: 10

    - id: group_manual
      name: "Manual / Diagnostics"
      sorting_weight: 20

    - id: group_wifi
      name: "WiFi Setup"
      sorting_weight: 30

    - id: group_mqtt
      name: "MQTT Setup"
      sorting_weight: 40

    - id: group_status
      name: "Device Status"
      sorting_weight: 50

    - id: group_system
      name: "System"
      sorting_weight: 60

globals:
  - id: blink_tick
    type: int
    restore_value: no
    initial_value: '0'

  - id: alarm_acknowledged
    type: bool
    restore_value: no
    initial_value: 'false'

# Physical MOSFET outputs.
# Semantic modes use only one lamp color at a time because the current
# HNTD TD-50 has a confirmed internal red/yellow interaction.
switch:
  - platform: gpio
    pin: GPIO16
    id: andon_red
    name: "Manual Red"
    restore_mode: ALWAYS_OFF
    web_server:
      sorting_group_id: group_manual
      sorting_weight: 10

  - platform: gpio
    pin: GPIO17
    id: andon_yellow
    name: "Manual Yellow"
    restore_mode: ALWAYS_OFF
    web_server:
      sorting_group_id: group_manual
      sorting_weight: 20

  - platform: gpio
    pin: GPIO26
    id: andon_green
    name: "Manual Green"
    restore_mode: ALWAYS_OFF
    web_server:
      sorting_group_id: group_manual
      sorting_weight: 30

  - platform: gpio
    pin: GPIO27
    id: andon_buzzer
    name: "Manual Buzzer"
    restore_mode: ALWAYS_OFF
    on_turn_on:
      - if:
          condition:
            switch.is_on: buzzer_mute_override
          then:
            - switch.turn_off: andon_buzzer
    web_server:
      sorting_group_id: group_manual
      sorting_weight: 40

  # Global demo/commissioning override.
  # ON means the buzzer is forcibly muted, regardless of the selected mode.
  - platform: template
    id: buzzer_mute_override
    name: "Buzzer Mute Override"
    icon: "mdi:volume-off"
    optimistic: true
    restore_mode: RESTORE_DEFAULT_OFF

    turn_on_action:
      - switch.turn_off: andon_buzzer
      - script.execute: render_andon

    turn_off_action:
      - script.execute: render_andon

    web_server:
      sorting_group_id: group_mode
      sorting_weight: 20

select:
  - platform: template
    id: andon_mode
    name: "Andon Mode"
    icon: "mdi:alarm-light"
    optimistic: true
    restore_value: false
    initial_option: "OFF"

    options:
      - "OFF"
      - "READY"
      - "RUNNING"
      - "STARTING"
      - "ATTENTION"
      - "WARNING"
      - "URGENT_WARNING"
      - "FAULT"
      - "CRITICAL"
      - "EMERGENCY"
      - "STOPPED"
      - "MAINTENANCE"
      - "MANUAL"

    set_action:
      - lambda: |-
          id(alarm_acknowledged) = false;
          id(blink_tick) = 0;

          if (x == "MANUAL") {
            id(andon_red).turn_off();
            id(andon_yellow).turn_off();
            id(andon_green).turn_off();
            id(andon_buzzer).turn_off();
          }

      - script.execute: render_andon

    web_server:
      sorting_group_id: group_mode
      sorting_weight: 10

button:
  - platform: template
    id: acknowledge_alarm
    name: "Acknowledge Alarm"
    icon: "mdi:check-circle-outline"

    on_press:
      - lambda: |-
          id(alarm_acknowledged) = true;
      - switch.turn_off: andon_buzzer
      - script.execute: render_andon

    web_server:
      sorting_group_id: group_mode
      sorting_weight: 30

  - platform: template
    id: clear_andon
    name: "Clear / OFF"
    icon: "mdi:power"

    on_press:
      - select.set:
          id: andon_mode
          option: "OFF"

    web_server:
      sorting_group_id: group_mode
      sorting_weight: 40

  - platform: template
    id: connect_new_wifi
    name: "Connect & Save WiFi"

    web_server:
      sorting_group_id: group_wifi
      sorting_weight: 30

    on_press:
      - logger.log: "Trying user-configured WiFi network"
      - wifi.configure:
          ssid: !lambda 'return id(setup_wifi_ssid).state;'
          password: !lambda 'return id(setup_wifi_password).state;'
          save: true
          timeout: 30s

          on_connect:
            - logger.log: "Connected to new WiFi network"

          on_error:
            - logger.log: "Failed to connect to new WiFi network"

  - platform: template
    id: connect_mqtt
    name: "Save & Connect MQTT"
    icon: "mdi:lan-connect"

    on_press:
      - if:
          condition:
            lambda: |-
              return !id(mqtt_broker_config).state.empty();
          then:
            - mqtt.disable:
            - delay: 500ms
            - lambda: |-
                id(mqtt_client).set_broker_address(id(mqtt_broker_config).state);
                id(mqtt_client).set_broker_port(
                  static_cast<uint16_t>(id(mqtt_port_config).state)
                );
                id(mqtt_client).set_username(id(mqtt_username_config).state);
                id(mqtt_client).set_password(id(mqtt_password_config).state);

                ESP_LOGI(
                  "mqtt_setup",
                  "Connecting to MQTT broker %s:%u",
                  id(mqtt_broker_config).state.c_str(),
                  static_cast<unsigned int>(id(mqtt_port_config).state)
                );
            - mqtt.enable:
          else:
            - logger.log:
                level: WARN
                format: "Cannot connect: MQTT broker field is empty"

    web_server:
      sorting_group_id: group_mqtt
      sorting_weight: 60

  - platform: template
    id: disconnect_mqtt
    name: "Disconnect MQTT"
    icon: "mdi:lan-disconnect"

    on_press:
      - mqtt.disable:

    web_server:
      sorting_group_id: group_mqtt
      sorting_weight: 70

  - platform: restart
    name: "Restart Andon Controller"

    web_server:
      sorting_group_id: group_system
      sorting_weight: 10

text:
  - platform: template
    id: setup_wifi_ssid
    name: "New WiFi SSID"
    optimistic: true
    min_length: 1
    max_length: 32
    mode: text
    restore_value: false

    web_server:
      sorting_group_id: group_wifi
      sorting_weight: 10

  - platform: template
    id: setup_wifi_password
    name: "New WiFi Password"
    optimistic: true
    min_length: 0
    max_length: 64
    mode: password
    restore_value: false

    web_server:
      sorting_group_id: group_wifi
      sorting_weight: 20

  # Runtime MQTT configuration.
  #
  # Values are saved in flash and survive reboot. The initial values
  # come from secrets.yaml only on the first boot before a value has
  # been stored locally.
  - platform: template
    id: mqtt_broker_config
    name: "MQTT Broker"
    icon: "mdi:server-network"
    optimistic: true
    min_length: 0
    max_length: 128
    mode: text
    restore_value: true
    initial_value: !secret mqtt_broker
    entity_category: config

    web_server:
      sorting_group_id: group_mqtt
      sorting_weight: 10

  - platform: template
    id: mqtt_username_config
    name: "MQTT Username"
    icon: "mdi:account"
    optimistic: true
    min_length: 0
    max_length: 128
    mode: text
    restore_value: true
    initial_value: !secret mqtt_username
    entity_category: config

    web_server:
      sorting_group_id: group_mqtt
      sorting_weight: 30

  - platform: template
    id: mqtt_password_config
    name: "MQTT Password"
    icon: "mdi:key"
    optimistic: true
    min_length: 0
    max_length: 128
    mode: password
    restore_value: true
    initial_value: !secret mqtt_password
    entity_category: config

    web_server:
      sorting_group_id: group_mqtt
      sorting_weight: 40

  - platform: template
    id: mqtt_topic_prefix_config
    name: "MQTT Topic Prefix"
    icon: "mdi:format-list-bulleted"
    optimistic: true
    min_length: 1
    max_length: 128
    mode: text
    restore_value: true
    initial_value: "hupla/demo/factory01/line01/andon01"
    entity_category: config

    web_server:
      sorting_group_id: group_mqtt
      sorting_weight: 50

number:
  - platform: template
    id: mqtt_port_config
    name: "MQTT Port"
    icon: "mdi:numeric"
    optimistic: true
    min_value: 1
    max_value: 65535
    step: 1
    restore_value: true
    initial_value: 1883
    entity_category: config

    web_server:
      sorting_group_id: group_mqtt
      sorting_weight: 20

binary_sensor:
  - platform: template
    id: mqtt_connected_sensor
    name: "MQTT Connected"
    icon: "mdi:lan-connect"
    entity_category: diagnostic
    lambda: |-
      return id(mqtt_client).is_connected();

    web_server:
      sorting_group_id: group_mqtt
      sorting_weight: 80

  - platform: template
    id: alarm_acknowledged_sensor
    name: "Alarm Acknowledged"
    lambda: |-
      return id(alarm_acknowledged);

    web_server:
      sorting_group_id: group_mode
      sorting_weight: 50

text_sensor:
  - platform: wifi_info
    ip_address:
      name: "IP Address"
      web_server:
        sorting_group_id: group_status
        sorting_weight: 10

    ssid:
      name: "Connected WiFi"
      web_server:
        sorting_group_id: group_status
        sorting_weight: 20

    bssid:
      name: "WiFi Access Point"
      web_server:
        sorting_group_id: group_status
        sorting_weight: 30

    mac_address:
      name: "ESP32 MAC Address"
      web_server:
        sorting_group_id: group_status
        sorting_weight: 40

sensor:
  - platform: wifi_signal
    name: "WiFi Signal"
    update_interval: 30s
    web_server:
      sorting_group_id: group_status
      sorting_weight: 50

  - platform: uptime
    name: "Uptime"
    update_interval: 60s
    web_server:
      sorting_group_id: group_status
      sorting_weight: 60

# One renderer owns all semantic alarm behavior.
#
# Timing base = 250 ms:
# slow flash   = 0.5 Hz
# normal flash = 1.0 Hz
# fast flash   = 2.0 Hz
#
# Acknowledge behavior:
# - stops the audible signal
# - changes an active warning/fault visual from flashing to steady
#
# Buzzer Mute Override:
# - forcibly disables the buzzer only
# - does not change the active mode or visual indication
script:
  - id: render_andon
    mode: restart

    then:
      - lambda: |-
          auto mode = id(andon_mode).current_option();
          const int tick = id(blink_tick);

          const bool slow_flash = tick < 4;               // 1s ON / 1s OFF
          const bool normal_flash = (tick % 4) < 2;       // 0.5s ON / 0.5s OFF
          const bool fast_flash = (tick % 2) == 0;        // 0.25s ON / 0.25s OFF

          bool red = false;
          bool yellow = false;
          bool green = false;
          bool buzzer = false;

          const bool ack = id(alarm_acknowledged);

          if (mode == "MANUAL") {
            if (id(buzzer_mute_override).state) {
              id(andon_buzzer).turn_off();
            }
            return;
          }

          if (mode == "OFF") {
            // all outputs remain off

          } else if (mode == "READY" || mode == "RUNNING") {
            green = true;

          } else if (mode == "STARTING") {
            green = slow_flash;

          } else if (mode == "ATTENTION") {
            yellow = true;

          } else if (mode == "WARNING") {
            yellow = ack ? true : slow_flash;
            buzzer = !ack && (tick == 0);                 // 250 ms every 2 s

          } else if (mode == "URGENT_WARNING") {
            yellow = ack ? true : normal_flash;
            buzzer = !ack && ((tick % 4) == 0);           // 250 ms every 1 s

          } else if (mode == "FAULT") {
            red = ack ? true : normal_flash;
            buzzer = !ack && normal_flash;                // 500 ms ON / 500 ms OFF

          } else if (mode == "CRITICAL") {
            red = ack ? true : fast_flash;
            buzzer = !ack && fast_flash;                  // 250 ms ON / 250 ms OFF

          } else if (mode == "EMERGENCY") {
            red = ack ? true : fast_flash;
            buzzer = !ack;                                // continuous until ACK/mute

          } else if (mode == "STOPPED") {
            red = true;

          } else if (mode == "MAINTENANCE") {
            yellow = true;
          }

          // Global demo/commissioning mute always wins.
          if (id(buzzer_mute_override).state) {
            buzzer = false;
          }

          if (red) id(andon_red).turn_on();
          else id(andon_red).turn_off();

          if (yellow) id(andon_yellow).turn_on();
          else id(andon_yellow).turn_off();

          if (green) id(andon_green).turn_on();
          else id(andon_green).turn_off();

          if (buzzer) id(andon_buzzer).turn_on();
          else id(andon_buzzer).turn_off();

interval:
  - interval: 250ms
    then:
      - lambda: |-
          id(blink_tick) = (id(blink_tick) + 1) % 8;
      - script.execute: render_andon

# MQTT transport is now runtime-configurable.
# Semantic command/state topics are the next step after the runtime
# broker configuration has been verified against the home Mosquitto
# broker and at least one alternate broker.
