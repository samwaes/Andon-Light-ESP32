# ESPHome Device Builder normally reads this file from:
# /config/esphome/secrets.yaml
#
# This is separate from Home Assistant's main /config/secrets.yaml.
#
# Copy only the keys you actually use. Never commit real credentials.

wifi_home_ssid: "HOME_WIFI"
wifi_home_password: "CHANGE_ME"

# Additional Wi-Fi networks can be provisioned at runtime through
# the Andon web interface. No second compiled SSID is required.

# Must be at least 8 characters for a protected Wi-Fi AP.
fallback_ap_password: "CHANGE_ME_STRONG_PASSWORD"

# IMPORTANT:
# Preserve the API encryption key that ESPHome already generated
# for the working andon-light-01 device.
# Do not replace it with an arbitrary password.
api_encryption_key: "REUSE_EXISTING_GENERATED_KEY"

# Preserve the deployed value if one already exists.
ota_password: "CHANGE_ME_OR_REUSE_EXISTING"

web_username: "admin"
web_password: "CHANGE_ME_STRONG_PASSWORD"

# Initial MQTT values. Firmware 0.5.0 copies these into runtime
# configuration fields on first use. After that, broker/port/login can
# be changed and persisted from the Andon's local web interface.
mqtt_broker: "192.168.129.15"
mqtt_username: "andon-light-01"
mqtt_password: "CHANGE_ME"

# MQTT port defaults to 1883 in the device YAML and can be changed
# from the web interface.
