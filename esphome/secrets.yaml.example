# ESPHome Device Builder normally reads this file from:
# /config/esphome/secrets.yaml
#
# This is separate from Home Assistant's main /config/secrets.yaml.
#
# Never commit the real secrets.yaml file.

wifi_home_ssid: "HOME_WIFI"
wifi_home_password: "CHANGE_ME"

# Additional Wi-Fi networks can be provisioned at runtime through
# the Andon local web interface.

# Must be at least 8 characters for a protected fallback AP.
fallback_ap_password: "CHANGE_ME_STRONG_PASSWORD"

# IMPORTANT:
# Preserve the generated API encryption key from the deployed device.
# Do not replace it with an arbitrary human password.
api_encryption_key: "REUSE_EXISTING_GENERATED_KEY"

# Preserve the deployed value unless intentionally rotating it.
ota_password: "CHANGE_ME_OR_REUSE_EXISTING"

# Local Web Server v3 Basic Auth.
web_username: "admin"
web_password: "CHANGE_ME_STRONG_PASSWORD"

# These MQTT values seed the runtime configuration.
# Firmware 0.5.0 stores broker/port/login settings in local restore storage,
# so they can later be changed from the Andon web interface without reflashing.
mqtt_broker: "192.168.129.15"
mqtt_username: "andon-light-01"
mqtt_password: "CHANGE_ME"

# MQTT port defaults to 1883 in the device YAML and is configurable at runtime.
#
# The MQTT Topic Prefix is not a secret and is defined in the device YAML.
# In firmware 0.5.0 it is reserved for future custom UNS topics and does not
# alter the current standard ESPHome MQTT topic hierarchy.
